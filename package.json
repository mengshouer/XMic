{
  "name": "xmic",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengshouer/XMic.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "bundle": "npm run version:check && npm run licenses:generate && npm run artifacts:check && tauri build --ci --config src-tauri/tauri.bundle.conf.json -- --locked && npm run bundle:assets",
    "bundle:assets": "npm run notices:check-embedded && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-release-assets.ps1",
    "artifacts:check": "node scripts/check-webrtc-artifacts.mjs",
    "notices:check-embedded": "node scripts/check-embedded-notices.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "preview": "vite preview",
    "test": "npm run test:web && npm run test:licenses",
    "test:web": "vitest run",
    "test:licenses": "node --test scripts/license-utils.test.mjs",
    "version:bump": "node scripts/bump-release-version.mjs",
    "version:check": "node scripts/check-release-version.mjs",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "spdx-expression-parse": "^5.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

import("//webrtc.gni")

rtc_shared_library("xmic_webrtc_dsp") {
  sources = [
    "include/xmic_webrtc_dsp.h",
    "src/xmic_webrtc_dsp.cc",
  ]

  defines = [ "XMIC_WEBRTC_DSP_IMPLEMENTATION" ]
  allow_poison = [ "environment_construction" ]
  suppressed_configs = [ "//build/config/clang:unsafe_buffers" ]

  deps = [
    "//api/audio:builtin_audio_processing_builder",
    "//api/audio:echo_detector_creator",
    "//api/environment:environment_factory",
    "//common_audio:common_audio_c",
  ]
}

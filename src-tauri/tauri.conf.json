{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XMic",
  "version": "0.3.6",
  "identifier": "com.mengshouer.xmic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XMic",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "font-src": "'self' http://localhost:1420",
        "img-src": "'self' http://localhost:1420 data:",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "script-src": "'self' http://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": false
  }
}
